{
  "name": "@openbots/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./server": {
      "types": "./src/entry.server.ts",
      "default": "./src/entry.server.ts"
    },
    "./native": {
      "types": "./src/entry.native.ts",
      "default": "./src/entry.native.ts"
    }
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@openbots/errors": "workspace:*"
  }
}
