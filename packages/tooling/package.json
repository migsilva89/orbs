{
  "name": "@openbots/tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vitest/arch": {
      "types": "./src/vitest/arch.ts",
      "default": "./src/vitest/arch.ts"
    }
  },
  "scripts": {
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
