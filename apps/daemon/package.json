{
  "name": "@repo/daemon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openbots": "./src/entry.native.ts"
  },
  "scripts": {
    "dev": "DATA_DIR=$HOME/.config/openbots-dev DAEMON_HOST=0.0.0.0 DAEMON_PORT=47191 WEB_PUBLIC_URL=http://localhost:47190 bun --env-file=../../.env --watch src/entry.native.ts",
    "start": "bun --env-file=../../.env src/entry.native.ts",
    "backup": "bun --env-file=../../.env src/entry-backup.native.ts",
    "check": "tsrs --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/runtime": "workspace:*",
    "@repo/secret-proxy": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/logger": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "ts-pattern": "catalog:",
    "uqr": "catalog:"
  }
}
