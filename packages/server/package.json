{
  "name": "@openbots/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsrs --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./native": "./src/entry.native.ts",
    "./server": {
      "types": "./src/entry.server.ts",
      "default": "./src/entry.server.ts"
    }
  },
  "dependencies": {
    "uqr": "catalog:",
    "@openbots/errors": "workspace:*",
    "@openbots/logger": "workspace:*",
    "@openbots/runtime": "workspace:*",
    "kysely": "catalog:",
    "zod": "catalog:",
    "@openbots/contracts": "workspace:*",
    "@orpc/server": "catalog:",
    "@orpc/shared": "catalog:",
    "@orpc/ratelimit": "catalog:",
    "@earendil-works/chord": "catalog:",
    "ts-pattern": "catalog:",
    "@typesafe-ai/sdk": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@openbots/i18n": "workspace:*",
    "takumi-js": "catalog:",
    "@openbots/avatar-blobs": "workspace:*"
  }
}
