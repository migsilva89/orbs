{
  "name": "@openbots/daemon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/entry.native.ts",
    "pair": "bun src/entry.native.ts pair",
    "check": "tsc --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  },
  "dependencies": {
    "@openbots/contracts": "workspace:*",
    "zod": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@openbots/server": "workspace:*",
    "@openbots/runtime": "workspace:*",
    "@openbots/env": "workspace:*",
    "@openbots/logger": "workspace:*",
    "@orpc/server": "catalog:",
    "ts-pattern": "catalog:",
    "@earendil-works/pi-durable": "catalog:"
  }
}
