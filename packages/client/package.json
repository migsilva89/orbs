{
  "name": "@openbots/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/entry.client.ts",
      "default": "./src/entry.client.ts"
    },
    "./react": {
      "types": "./src/entry.react.ts",
      "default": "./src/entry.react.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@openbots/avatar-blobs": "workspace:*",
    "@openbots/contracts": "workspace:*",
    "@openbots/errors": "workspace:*",
    "@openbots/i18n": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "ai": "catalog:",
    "ts-pattern": "catalog:"
  },
  "peerDependencies": {
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:"
  }
}
