{
  "name": "openbots",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/daemon",
    "packages/*"
  ],
  "catalog": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@orpc/client": "2.0.0-beta.39",
    "@orpc/contract": "2.0.0-beta.39",
    "@orpc/server": "2.0.0-beta.39",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/router-core": "^1.171.32",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "evlog": "^2.29.0",
    "kysely": "^0.29.6",
    "oxc-parser": "^0.151.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-arch": "0.6.1",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "*",
    "schema-dts": "^2.0.0",
    "ts-pattern": "^5.9.0",
    "turbo": "^2.11.4",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "uqr": "^0.1.2",
    "vite": "^8.3.1",
    "vitest": "5.0.1",
    "zod": "^4.6.5",
    "@typesafe-ai/sdk": "0.6.0",
    "fallow": "3.34.0",
    "@earendil-works/pi-mcp": "1.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-arch": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "fallow": "catalog:"
  },
  "scripts": {
    "check": "turbo run check",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --bail=1",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint --continue && oxlint scripts -c ./oxlint.config.ts --disable-nested-config && bun run lint:cycles",
    "lint:fix": "turbo run lint:fix --continue && oxlint scripts -c ./oxlint.config.ts --disable-nested-config --fix",
    "lint:cycles": "fallow architecture --cycles --fail-on-issues"
  }
}
