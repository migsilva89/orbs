  "dependencies": {
    "oxc-parser": "catalog:"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
