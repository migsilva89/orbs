{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/**/*.ts"
  ],
  "ignorePatterns": [
    "packages/i18n/src/paraglide/**",
    "**/*.generated.ts"
  ],
  "ignoreDependencies": [
    "oxlint-tsgolint",
    "typescript",
    "turbo"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "workspaces": {
    "patterns": [
      "apps/daemon",
      "packages/*"
    ]
  }
}
