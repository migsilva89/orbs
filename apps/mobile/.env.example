# App identity for your own builds. Copy to .env; every value is optional.
# APP_VARIANT (development | preview | production) adds " Dev"/" Preview" to the name,
# "-dev"/"-preview" to the scheme and ".dev"/".preview" to the bundle ID.
# EAS cloud builds do not upload .env: set the same values with `eas env:create`.

# Home screen name. Default: Openbots
OPENBOTS_APP_NAME=
# Expo slug; must match your EAS project. Default: openbots
OPENBOTS_APP_SLUG=
# Deep link scheme. Default: openbots
OPENBOTS_APP_SCHEME=
# iOS bundle ID and Android package; the notification extension and app group derive from it. Default: app.openbots.mobile
OPENBOTS_BUNDLE_ID=
# Apple Developer team that signs the app and its notification extension.
OPENBOTS_APPLE_TEAM_ID=
# Expo account and EAS project ID (from `eas init`); needed for push notifications.
OPENBOTS_EAS_OWNER=
OPENBOTS_EAS_PROJECT_ID=
