{
  "name": "@openbots/daemon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OPENBOTS_DATA_DIR=$HOME/.config/openbots-dev OPENBOTS_HOST=127.0.0.1 OPENBOTS_PORT=47191 OPENBOTS_PUBLIC_URL=http://localhost:47190 bun --watch src/entry.native.ts",
    "start": "bun src/entry.native.ts",
    "backup": "bun src/entry-backup.native.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  },
  "dependencies": {
    "@openbots/contracts": "workspace:*",
    "@openbots/errors": "workspace:*",
    "@openbots/server": "workspace:*",
    "@openbots/runtime": "workspace:*",
    "@openbots/env": "workspace:*",
    "@openbots/logger": "workspace:*",
    "@orpc/server": "catalog:",
    "ts-pattern": "catalog:",
    "uqr": "catalog:"
  }
}
