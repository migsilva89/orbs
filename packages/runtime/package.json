{
  "name": "@openbots/runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "devDependencies": {
    "@openbots/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./server": {
      "types": "./src/entry.server.ts",
      "default": "./src/entry.server.ts"
    },
    "./native": {
      "types": "./src/entry.native.ts",
      "default": "./src/entry.native.ts"
    }
  },
  "dependencies": {
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@openbots/errors": "workspace:*",
    "@openbots/i18n": "workspace:*",
    "ts-pattern": "catalog:",
    "@earendil-works/pi-mcp": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@openbots/contracts": "workspace:*",
    "@openbots/logger": "workspace:*",
    "zod": "catalog:",
    "cron-parser": "catalog:",
    "@json-render/core": "catalog:"
  }
}
