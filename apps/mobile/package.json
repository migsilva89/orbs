{
  "name": "@openbots/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "dev": "lsof -ti tcp:8081 | xargs kill -9 2>/dev/null; bun run sim:pin && APP_VARIANT=development expo start --dev-client --ios",
    "dev:native": "lsof -ti tcp:8081 | xargs kill -9 2>/dev/null; bun run sim:pin && APP_VARIANT=development expo run:ios",
    "sim:pin": "UDID=$(xcrun simctl list devices available | grep 'iPhone 17 Pro (' | head -1 | grep -oE '[0-9A-F-]{36}') && xcrun simctl boot \"$UDID\" 2>/dev/null; defaults write com.apple.iphonesimulator CurrentDeviceUDID \"$UDID\"; open -a Simulator",
    "ios": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android",
    "eas:dev": "eas build --profile development",
    "eas:preview": "eas build --profile preview",
    "eas:prod": "eas build --profile production",
    "check": "tsc --noEmit",
    "lint": "oxlint src/ index.ts app.config.ts -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ index.ts app.config.ts -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "catalog:mobile",
    "@openbots/i18n": "workspace:*",
    "@react-navigation/native": "catalog:mobile",
    "@react-navigation/native-stack": "catalog:mobile",
    "expo": "catalog:mobile",
    "expo-font": "catalog:mobile",
    "expo-system-ui": "catalog:mobile",
    "react": "catalog:mobile",
    "react-native": "catalog:mobile",
    "react-native-safe-area-context": "catalog:mobile",
    "react-native-screens": "catalog:mobile",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:mobile",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:mobile",
    "typescript": "catalog:"
  }
}
